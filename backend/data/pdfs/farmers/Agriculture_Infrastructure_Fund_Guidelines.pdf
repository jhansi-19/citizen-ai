    <script>
        $(document).ready(function () {
            document.getElementById("increase-font").addEventListener("click", () => adjustFontSize(2));
            document.getElementById("decrease-font").addEventListener("click", () => adjustFontSize(-2));
            document.getElementById("reset-font").addEventListener("click", resetFontSize);
            function adjustFontSize(change) {
                let root = document.documentElement;
                let currentSize = parseInt(getComputedStyle(root).getPropertyValue('--font-size'));
                let newSize = currentSize + change;
                root.style.setProperty('--font-size', newSize + 'px');
            }
            function resetFontSize() {
                document.documentElement.style.setProperty('--font-size', '16px');
            }
        });
    </script>
