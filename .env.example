# ─── Core LLM / AI ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# ─── LLM Config (swap without code changes) ───────────────────────────────────
# Options: "gemini" | "groq"
LLM_PROVIDER=gemini
# Gemini model options: gemini-1.5-flash (free) | gemini-1.5-pro (free, lower quota)
GEMINI_MODEL=gemini-1.5-flash
# Groq model options: llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Rate Limiting (protect free API quotas) ──────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
CACHE_MAX_SIZE=500

# ─── Vector DB ────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Retrieval ────────────────────────────────────────────────────────────────
# How many chunks to retrieve per query
TOP_K=5
# Retrieval mode: "dense" | "hybrid" | "reranked"
RETRIEVAL_MODE=dense
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Data Paths ───────────────────────────────────────────────────────────────
PDF_DIR=./data/pdfs
CHUNKS_DIR=./data/chunks
LOGS_DB_PATH=./logs/citizen_ai.db

# ─── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_this_password

# ─── Monitoring (Langfuse - optional, free tier) ──────────────────────────────
# Leave blank to use local SQLite logging instead
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Web Search (DuckDuckGo - no key needed) ──────────────────────────────────
# Tavily free tier (optional backup, get key at app.tavily.com - no card)
TAVILY_API_KEY=
